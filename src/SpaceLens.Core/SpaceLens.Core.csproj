<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that isn't UI: the scanner, cleanup rules, history, credentials and the Claude client.
    It deliberately doesn't reference WPF, so business logic can't depend on the view layer.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SpaceLens.Core</RootNamespace>
    <AssemblyName>SpaceLens.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.21" />
    <!-- Pins the native SQLite bundle above the vulnerable transitive version. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpaceLens.Tests" />
  </ItemGroup>

</Project>
