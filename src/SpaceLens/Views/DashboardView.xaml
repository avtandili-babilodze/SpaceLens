<UserControl x:Class="SpaceLens.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SpaceLens.Controls"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
  <UserControl.Resources>
    <Style x:Key="FigureLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FigureValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,0,1" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FigureCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Tertiary}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FigureRule" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="24,4" />
      <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}" Padding="24,20,24,18">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Headline: how full the drive is, set like a measurement -->
      <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="UsedSpace">
        <Run Text="{Binding UsedText, Mode=OneWay}" FontFamily="{StaticResource NumberFont}" FontSize="38" FontWeight="SemiBold" />
        <Run Text=" used " FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
        <Run Text="{Binding CapacityText, Mode=OneWay}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
      </TextBlock>

      <!-- Figures beside the headline; under it when the window is narrow -->
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Margin" Value="0,14,0,0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <StackPanel ToolTip="{Binding RecoverableDetail}" MinWidth="110">
          <TextBlock Text="Recoverable" Style="{StaticResource FigureLabel}" />
          <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource FigureValue}" AutomationProperties.AutomationId="Recoverable" />
          <TextBlock Text="{Binding RecoverableCaption}" Style="{StaticResource FigureCaption}" />
        </StackPanel>
        <Border Style="{StaticResource FigureRule}" />
        <StackPanel MinWidth="90">
          <TextBlock Text="Large files" Style="{StaticResource FigureLabel}" />
          <TextBlock Text="{Binding LargeFileCountText}" Style="{StaticResource FigureValue}" AutomationProperties.AutomationId="LargeFiles" />
          <TextBlock Text="Files over 1 GB" Style="{StaticResource FigureCaption}" />
        </StackPanel>
        <Border Style="{StaticResource FigureRule}" />
        <StackPanel MinWidth="90">
          <TextBlock Text="Growth" Style="{StaticResource FigureLabel}" />
          <TextBlock Text="{Binding GrowthText}" Style="{StaticResource FigureValue}" AutomationProperties.AutomationId="Growth" />
          <TextBlock Text="{Binding GrowthCaption}" Style="{StaticResource FigureCaption}" />
        </StackPanel>
      </StackPanel>

      <!-- The drive as one bar: largest folders, the rest, then free space -->
      <controls:CapacityBar Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Height="14"
                            Margin="0,18,0,0"
                            CornerRadius="4"
                            Segments="{Binding Segments}"
                            TrackBrush="{StaticResource CapacityTrackBrush}"
                            AutomationProperties.Name="Drive usage" />

      <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
          <Border Width="9" Height="9" CornerRadius="2" Background="{StaticResource CapacityTrackBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FreeText}" FontFamily="{StaticResource NumberFont}" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="FreeSpace">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLowOnSpace}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CapacitySegment}">
              <StackPanel Orientation="Horizontal" Margin="0,2,22,2">
                <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Color, Converter={StaticResource ColorToBrush}}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource NumberFont}" FontSize="13.5" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
