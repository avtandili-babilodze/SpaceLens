<Window x:Class="SpaceLens.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SpaceLens.Views"
        xmlns:vm="clr-namespace:SpaceLens.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SpaceLens"
        Icon="/Assets/SpaceLens.ico"
        Width="1640"
        Height="960"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="Manual"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Closing="OnClosing"
        StateChanged="OnStateChanged"
        SizeChanged="OnSizeChanged">

  <!-- Restored, the window keeps a (hidden) system frame for resizing and snapping; maximized it goes full screen (see MainWindow.xaml.cs) -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    <KeyBinding Key="F5" Command="{Binding Scan.ScanDriveCommand}" />
    <KeyBinding Key="Escape" Command="{Binding Scan.CancelCommand}" />
  </Window.InputBindings>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar (an icon rail when the window is narrow) -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="19,24,12,30">
          <ContentControl ContentTemplate="{StaticResource LogoMark}" Focusable="False" />
          <TextBlock Text="SpaceLens" FontSize="21" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"
                     Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="14,12" CornerRadius="10" Background="#111D2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Scans stay on this PC" FontSize="12" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Tertiary}" Margin="15,4,0,0" TextWrapping="Wrap">
              <Run Text="Assistant:" />
              <Run Text="{Binding Assistant.ModeLabel, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding Navigation}"
                 SelectedItem="{Binding SelectedNavigation}"
                 Style="{StaticResource NavigationList}"
                 ItemContainerStyle="{StaticResource NavigationItem}"
                 Margin="12,0"
                 AutomationProperties.AutomationId="Navigation">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:NavigationItem}">
              <StackPanel Orientation="Horizontal" ToolTip="{Binding Label}">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Glyph}" FontSize="18" Width="22" />
                <TextBlock Text="{Binding Label}" Margin="14,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="22,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition x:Name="RightColumn" Width="380" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>

      <!-- Main column -->
      <Grid Margin="0,18,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: drive, search, scan -->
        <Grid shell:WindowChrome.IsHitTestVisibleInChrome="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ComboBox ItemsSource="{Binding Scan.Drives}"
                    SelectedItem="{Binding Scan.SelectedDrive}"
                    Style="{StaticResource DriveSelector}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.AutomationId="DriveSelector"
                    ToolTip="Choose a drive to scan" />

          <Grid Grid.Column="1" Margin="24,0,14,0" Height="50" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBox x:Name="SearchBox"
                     Text="{Binding Explorer.SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchBox}"
                     Tag="Search folders, files, or ask a question…"
                     AutomationProperties.AutomationId="SearchBox">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </Grid>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Command="{Binding Scan.ScanFolderCommand}" Height="44" Padding="14,0" ToolTip="Scan a specific folder" AutomationProperties.AutomationId="ChooseFolder">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE838;" Style="{StaticResource Text.Glyph}" FontSize="15" />
                <TextBlock Text="Folder" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Command="{Binding Scan.ScanDriveCommand}" Style="{StaticResource Button.Primary}" Height="44" Padding="16,0" Margin="8,0,0,0" ToolTip="Scan the selected drive (F5)" AutomationProperties.AutomationId="StartScan">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Glyph}" FontSize="14" />
                <TextBlock Margin="8,0,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Rescan" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Scan.HasScan}" Value="False">
                          <Setter Property="Text" Value="Scan drive" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Summary cards (Overview only) -->
        <views:DashboardView Grid.Row="1"
                             DataContext="{Binding Dashboard}"
                             Margin="0,18,0,0"
                             Visibility="{Binding DataContext.ShowSummaryCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <!-- Pages -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <views:ExplorerView DataContext="{Binding Explorer}"
                              Visibility="{Binding DataContext.IsWorkspacePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
          <views:CleanupView DataContext="{Binding Cleanup}"
                             Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Cleanup}" />
          <views:CompareView DataContext="{Binding Compare}"
                             Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Compare}" />
          <views:DuplicatesView DataContext="{Binding Duplicates}"
                                Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Duplicates}" />
          <views:AppsView DataContext="{Binding Apps}"
                          Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Apps}" />
          <views:SystemSpaceView DataContext="{Binding SystemSpace}"
                                 Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=SystemSpace}" />
          <views:HistoryView DataContext="{Binding History}"
                             Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=History}" />
          <views:SettingsView DataContext="{Binding Settings}"
                              Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Settings}" />

          <!-- First run: nothing scanned yet -->
          <Border Style="{StaticResource Card}" Padding="40">
            <Border.Visibility>
              <MultiBinding Converter="{StaticResource BoolPatternToVisibility}" ConverterParameter="False,False,True">
                <Binding Path="Scan.HasScan" />
                <Binding Path="Scan.IsScanning" />
                <Binding Path="IsWorkspacePage" />
              </MultiBinding>
            </Border.Visibility>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
              <Image Source="{StaticResource DriveArtwork}" Width="112" Height="84" />
              <TextBlock Text="See what's filling your drive" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,22,0,8" />
              <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                         Text="SpaceLens measures every folder on the drive, finds caches and leftovers that are safe to clean, and explains the rest. Nothing leaves this PC unless you ask Claude." />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Command="{Binding Scan.ScanDriveCommand}" Style="{StaticResource Button.Primary}" Padding="20,11" AutomationProperties.AutomationId="EmptyStateScan">
                  <TextBlock>
                    <Run Text="Scan" />
                    <Run Text="{Binding Scan.SelectedDrive.DisplayName, Mode=OneWay}" />
                  </TextBlock>
                </Button>
                <Button Command="{Binding Scan.ScanFolderCommand}" Content="Choose a folder" Padding="18,11" Margin="10,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Scan in progress -->
          <Border Style="{StaticResource Card}" Padding="40" Visibility="{Binding Scan.IsScanning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
              <TextBlock Text="&#xE721;" Style="{StaticResource Text.Glyph}" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,18,0,6" TextTrimming="CharacterEllipsis">
                <Run Text="Scanning" />
                <Run Text="{Binding Scan.Target, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Scan.ProgressText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" AutomationProperties.AutomationId="ScanProgress" />
              <ProgressBar IsIndeterminate="True" Margin="0,22,0,12" />
              <TextBlock Text="{Binding Scan.ProgressPath}" Style="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Command="{Binding Scan.CancelCommand}" Content="Stop scan" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="18,9" AutomationProperties.AutomationId="CancelScan" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Right column: details and assistant -->
      <Grid x:Name="RightPanel" Grid.Column="2" Margin="0,48,16,0">
        <!-- Details and assistant share the column, the assistant taking the larger part (about 40/60); a collapsed assistant gives its space back. -->
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition>
            <RowDefinition.Style>
              <Style TargetType="RowDefinition">
                <Setter Property="Height" Value="1.5*" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Assistant.IsExpanded}" Value="False">
                    <Setter Property="Height" Value="Auto" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Assistant.IsOpen}" Value="False">
                    <Setter Property="Height" Value="Auto" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </RowDefinition.Style>
          </RowDefinition>
        </Grid.RowDefinitions>
        <views:DetailsView DataContext="{Binding Details}"
                           Visibility="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        <views:AssistantView DataContext="{Binding Assistant}" Margin="0,14,0,0">
          <views:AssistantView.Style>
            <Style TargetType="views:AssistantView">
              <Setter Property="Grid.Row" Value="1" />
              <Setter Property="MinHeight" Value="320" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShowDetails, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                  <Setter Property="Grid.Row" Value="0" />
                  <Setter Property="Grid.RowSpan" Value="2" />
                  <Setter Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                  <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:AssistantView.Style>
        </views:AssistantView>
        <Button Grid.Row="1"
                Command="{Binding Assistant.OpenCommand}"
                Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Padding="16,10"
                Visibility="{Binding Assistant.IsOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource SparkleGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Ask AI" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Window buttons -->
      <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="&#xE921;" Style="{StaticResource Button.Caption}" Click="OnMinimize" AutomationProperties.Name="Minimize" />
        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource Button.Caption}" Click="OnMaximize" AutomationProperties.Name="Maximize" />
        <Button Content="&#xE8BB;" Style="{StaticResource Button.CaptionClose}" Click="OnClose" AutomationProperties.Name="Close" />
      </StackPanel>

      <!-- Status bar -->
      <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,16,0">
        <TextBlock Text="{Binding Scan.Summary}" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,320,0" />
        <TextBlock Text="{Binding Scan.StatusText}" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.AutomationId="StatusText" />
      </Grid>

      <!-- Notification -->
      <Border Grid.ColumnSpan="3"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,12"
              Padding="16,10"
              CornerRadius="10"
              MaxWidth="760"
              BorderThickness="1"
              Visibility="{Binding Notifications.Text, Converter={StaticResource HasValueToVisibility}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="#16283E" />
            <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Notifications.IsError}" Value="True">
                <Setter Property="Background" Value="#3A1D24" />
                <Setter Property="BorderBrush" Value="#6B2F38" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Notifications.Text}" TextWrapping="Wrap" MaxWidth="660" VerticalAlignment="Center" AutomationProperties.AutomationId="Notification" />
          <Button Content="&#xE711;" Style="{StaticResource Button.Icon}" Width="24" Height="24" FontSize="10" Margin="12,0,0,0" Command="{Binding Notifications.DismissCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
