<UserControl x:Class="SpaceLens.Views.SystemSpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SystemSpaceViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="22,18">
      <Grid>
        <StackPanel Margin="0,0,140,0">
          <TextBlock Text="System space" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"
                     Text="Big files and folders Windows keeps for itself. SpaceLens never deletes them; each card opens the Windows tool that can shrink it safely and explains what you'd give up." />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Metric}" FontSize="20" Margin="0,12,0,0" AutomationProperties.AutomationId="SystemSpaceSummary" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="14,8" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Glyph}" FontSize="13" />
            <TextBlock Text="Measure again" Margin="8,0,0,0" />
          </StackPanel>
        </Button>
        <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-8"
                     Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="SystemSpaceItems">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SystemSpaceItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="20,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="#1A2A40" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Glyph}" FontSize="19" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" />
                  <TextBlock Text="{Binding SizeText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0" />
                <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,7"
                        Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Glyph}" FontSize="13" Margin="0,0,8,0" ToolTip="Asks for administrator permission"
                               Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ActionText}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
