<Window x:Class="SpaceLens.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceLens"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True">
  <Border Margin="12" Padding="18,16" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource SelectionBorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="Black" />
    </Border.Effect>
    <StackPanel>
      <Grid>
        <StackPanel Orientation="Horizontal">
          <ContentControl ContentTemplate="{StaticResource LogoMark}" Focusable="False">
            <ContentControl.LayoutTransform>
              <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
            </ContentControl.LayoutTransform>
          </ContentControl>
          <TextBlock Text="SpaceLens" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="  ·  daily check" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Content="&#xE8BB;" Style="{StaticResource Button.Icon}" FontSize="10" Width="28" Height="28" HorizontalAlignment="Right" Click="OnDismiss" ToolTip="Dismiss" />
      </Grid>

      <ItemsControl x:Name="AlertList" Margin="0,12,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Open SpaceLens" Style="{StaticResource Button.Primary}" Padding="16,8" Click="OnOpen" />
        <Button Content="Dismiss" Padding="16,8" Margin="8,0,0,0" Click="OnDismiss" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
