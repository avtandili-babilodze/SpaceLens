<UserControl x:Class="SpaceLens.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="22,18">
      <Grid>
        <StackPanel Margin="0,0,330,0">
          <TextBlock Text="Apps" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"
                     Text="Programs installed on this PC, with their size and when you last started them from Start, the taskbar or File Explorer. Uninstall runs the app's own uninstaller." />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Metric}" FontSize="20" Margin="0,12,0,0" AutomationProperties.AutomationId="AppsSummary" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="310">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="14,8" Command="{Binding AskAiCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource SparkleGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Which can I remove?" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Content="&#xE72C;" Style="{StaticResource Button.Icon}" Margin="6,0,0,0" ToolTip="Refresh" Command="{Binding RefreshCommand}" />
          </StackPanel>
          <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Tag="Filter by name or publisher" Margin="0,12,0,0" AutomationProperties.AutomationId="AppsFilter" />
          <Button Content="Open Windows' Apps settings" Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="12" Command="{Binding OpenAppsSettingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
      <Grid>
        <DataGrid ItemsSource="{Binding Apps}" Margin="6,6,6,0" AutomationProperties.AutomationId="AppsGrid">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="App" Width="*" MinWidth="220" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xECAA;" Style="{StaticResource Text.Glyph}" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Icon, Converter={StaticResource HasValueToVisibility}}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Tertiary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Size" Width="104" SortMemberPath="SizeBytes" SortDirection="Descending">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                  <TextBlock Text="{Binding SizeText}" ToolTip="{Binding SizeTooltip}" Style="{StaticResource Text.Number}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Last used" Width="136" SortMemberPath="LastUsed">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                  <TextBlock Text="{Binding LastUsedText}" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUnused}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource RiskReviewForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Installed" Width="116" Binding="{Binding InstalledText}" SortMemberPath="Installed">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTemplateColumn Width="128" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                  <Button Content="Uninstall…" Style="{StaticResource Button.Ghost}" Padding="12,5" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0"
                          Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding CanUninstall}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" Margin="12,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
