<UserControl x:Class="SpaceLens.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="22,18">
      <StackPanel>
        <Grid>
          <StackPanel>
            <TextBlock Text="Duplicate files" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="Finds files of 100 KB or more with identical contents (same size, same SHA-256). System and app files are left out, and hard links aren't counted twice."
                       Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,280,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="Stop" Padding="16,8" Command="{Binding FindCancelCommand}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Find duplicates" Style="{StaticResource Button.Primary}" Padding="18,8" Margin="8,0,0,0" Command="{Binding FindCommand}" AutomationProperties.AutomationId="FindDuplicates" />
          </StackPanel>
        </Grid>
        <ProgressBar Maximum="100" Value="{Binding Progress}" Margin="0,16,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="DuplicateStatus" />
        <Grid Margin="0,12,0,0" Visibility="{Binding Summary, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Metric}" FontSize="22" />
          <Button HorizontalAlignment="Right" Style="{StaticResource Button.Primary}" Padding="16,8" Command="{Binding RecycleSelectedCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Glyph}" FontSize="13" />
              <TextBlock Text="Move selected copies to Recycle Bin…" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.AutomationId="DuplicateGroups">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
              <StackPanel>
                <Grid Margin="4,0,0,8">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" TextTrimming="CharacterEllipsis" Margin="0,0,280,0" />
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Files}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StorageItemViewModel}">
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRemove}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <ContentControl Grid.Column="1" Content="{Binding Icon}" ContentTemplate="{StaticResource NodeIconTemplate}" Focusable="False" />
                        <TextBlock Grid.Column="2" Text="{Binding FullPath}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Content="&#xE8B7;" Style="{StaticResource Button.Icon}" ToolTip="Show in SpaceLens"
                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
