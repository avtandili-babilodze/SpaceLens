<UserControl x:Class="SpaceLens.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpaceLens.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CompareViewModel}">
  <UserControl.Resources>
    <DataTemplate x:Key="ChangeRow" DataType="{x:Type vm:ChangeRowViewModel}">
      <Button Style="{StaticResource Button.Ghost}" Padding="10,8" HorizontalContentAlignment="Stretch"
              Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}"
              ToolTip="{Binding Path}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="96" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" />
              <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" />
            </TextBlock>
            <TextBlock Text="{Binding Location}" Style="{StaticResource Text.Tertiary}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0">
            <Run Text="{Binding BeforeText, Mode=OneWay}" />
            <Run Text=" → " />
            <Run Text="{Binding AfterText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock x:Name="Delta" Grid.Column="2" Text="{Binding DeltaText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsGrowth}" Value="True">
          <Setter TargetName="Delta" Property="Foreground" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="22,18">
      <StackPanel>
        <TextBlock Text="Compare scans" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="Every completed scan is saved on this PC. Pick two scans of the same location to see what grew, what shrank and which large files appeared."
                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MaxWidth="340" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Earlier scan" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Before}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="BeforeSnapshot" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Text.Glyph}" Foreground="{StaticResource TextTertiaryBrush}" Margin="14,20,14,0" />
          <StackPanel Grid.Column="2">
            <TextBlock Text="Later scan" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding After}" DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="AfterSnapshot" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,0">
            <Button Content="Compare" Style="{StaticResource Button.Primary}" Padding="18,8" Command="{Binding CompareCommand}" AutomationProperties.AutomationId="CompareScans" />
            <Button Margin="8,0,0,0" Padding="14,8" Command="{Binding AskAboutChangesCommand}" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE99A;" Style="{StaticResource Text.Glyph}" FontSize="14" />
                <TextBlock Text="Ask AI to explain" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button Content="&#xE72C;" Style="{StaticResource Button.Icon}" Margin="4,0,0,0" ToolTip="Reload history" Command="{Binding ReloadCommand}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,14,0,0" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Net change -->
      <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding NetChangeText}" Style="{StaticResource Text.Metric}" AutomationProperties.AutomationId="NetChange" />
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Net change in scanned size" Style="{StaticResource Text.Secondary}" />
            <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Text.Tertiary}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Folders that grew" Style="{StaticResource Text.Section}" Margin="10,4,0,8" />
          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="10,8,10,2"
                     Text="Each folder listed explains most of its own growth, so nested folders aren't repeated. Click a row to open it." />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Grew}" ItemTemplate="{StaticResource ChangeRow}" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="New or larger files (100 MB+)" Style="{StaticResource Text.Section}" Margin="10,4,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding NewFiles}" ItemTemplate="{StaticResource ChangeRow}" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Folders that shrank" Style="{StaticResource Text.Section}" Margin="10,4,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Shrank}" ItemTemplate="{StaticResource ChangeRow}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
