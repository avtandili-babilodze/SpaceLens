<Window x:Class="SpaceLens.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceLens"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True">
  <Border Margin="12" Padding="26,22" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
    </Border.Effect>
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
      <Border x:Name="DetailsPanel" Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <ItemsControl x:Name="DetailsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Margin="0,3" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock x:Name="FootnoteText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="17" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="CancelButton" Content="Cancel" Padding="18,8" IsCancel="True" Click="OnCancel" AutomationProperties.AutomationId="DialogCancel" />
        <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" Padding="18,8" Margin="10,0,0,0" Click="OnConfirm" AutomationProperties.AutomationId="DialogConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
