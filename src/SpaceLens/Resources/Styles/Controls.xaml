<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography: Segoe UI for reading, Bahnschrift for measurements and page titles -->
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.Tertiary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
  </Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Sizes and counts in lists, so every measurement reads the same way -->
  <Style x:Key="Text.Number" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="Text.Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Cleanup risk tag: the DataContext must expose a CleanupRisk "Risk" property -->
  <Style x:Key="RiskBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2,7,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource RiskReviewBackground}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource RiskReviewForeground}" />
    <Setter Property="TextElement.FontSize" Value="11.5" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Risk}" Value="Low">
        <Setter Property="Background" Value="{StaticResource RiskLowBackground}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource RiskLowForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Risk}" Value="High">
        <Setter Property="Background" Value="{StaticResource RiskHighBackground}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource RiskHighForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Risk}" Value="Protected">
        <Setter Property="Background" Value="{StaticResource RiskProtectedBackground}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource RiskProtectedForeground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Risk in long lists: a coloured dot and a word, so a column of risks stays calm -->
  <Style x:Key="RiskDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource RiskReviewForeground}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Risk}" Value="Low">
        <Setter Property="Fill" Value="{StaticResource RiskLowForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Risk}" Value="High">
        <Setter Property="Fill" Value="{StaticResource RiskHighForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Risk}" Value="Protected">
        <Setter Property="Fill" Value="{StaticResource RiskProtectedForeground}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="RiskText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource RiskReviewForeground}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Risk}" Value="Low">
        <Setter Property="Foreground" Value="{StaticResource RiskLowForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Risk}" Value="High">
        <Setter Property="Foreground" Value="{StaticResource RiskHighForeground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Risk}" Value="Protected">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Buttons: hover and pressed colours live in style triggers so derived styles can override them.
       Keyboard focus draws a ring outside the button, the same on every button. -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
    <Grid>
      <Border x:Name="FocusRing"
              Margin="-3"
              CornerRadius="9"
              BorderThickness="2"
              BorderBrush="{StaticResource AccentHoverBrush}"
              Visibility="Collapsed" />
      <Border x:Name="Chrome"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}"
              SnapsToDevicePixels="True">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Secondary: an outlined button for everything that isn't the page's main action -->
  <Style TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#292F36" />
        <Setter Property="BorderBrush" Value="#4A525D" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#1C2126" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Primary: one per screen, for the action the page exists for -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#C2474B" />
    <Setter Property="BorderBrush" Value="#C2474B" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#D25458" />
        <Setter Property="BorderBrush" Value="#D25458" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#A83C40" />
        <Setter Property="BorderBrush" Value="#A83C40" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#A9CBFF" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="Button.Caption" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Text input with an optional placeholder in Tag -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <!-- TextBox applies Padding to PART_ContentHost itself; only the placeholder needs it here -->
            <Grid>
              <TextBlock x:Name="Placeholder"
                         Text="{TemplateBinding Tag}"
                         Foreground="{StaticResource TextTertiaryBrush}"
                         Margin="{TemplateBinding Padding}"
                         Padding="2,0,0,0"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False"
                         Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A525D" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A525D" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Check box -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box"
                    Width="18"
                    Height="18"
                    CornerRadius="4"
                    BorderThickness="1.5"
                    BorderBrush="#4A525C"
                    Background="Transparent"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <TextBlock x:Name="Check"
                         Text="&#xE73E;"
                         FontFamily="{StaticResource IconFont}"
                         FontSize="11"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
            </Border>
            <ContentPresenter x:Name="Label"
                              Grid.Column="1"
                              Margin="10,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="#7A838E" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              <Setter TargetName="Box" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented toggle (RadioButton) -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#2A3038" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegmentHost" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- Combo box -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#2A3038" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectionBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,7,32,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MaxDropDownHeight" Value="360" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <TextBlock Text="&#xE70D;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="#292F36" />
                      <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A525D" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <Popup Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
              <Border Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="#1F242A"
                      BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="4">
                <ScrollViewer>
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin scroll bars -->
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" CornerRadius="3" Background="#333A43" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="#48505B" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="#5C6570" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" Margin="2,2" />
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" Margin="2,2" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Menus and tool tips -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="#1F242A"
                  BorderBrush="{StaticResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="4"
                  MinWidth="200">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Chrome" CornerRadius="5" Padding="10,7" Background="Transparent">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon"
                                TextElement.Foreground="{StaticResource TextSecondaryBrush}"
                                TextElement.FontFamily="{StaticResource IconFont}"
                                TextElement.FontSize="13"
                                VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#2A3038" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{StaticResource BorderBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#1F242A"
                  BorderBrush="{StaticResource BorderStrongBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10,7"
                  MaxWidth="420">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress: thin bar with an indeterminate runner -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource CapacityTrackBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            <Border x:Name="Runner" Width="160" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" Visibility="Collapsed">
              <Border.RenderTransform>
                <TranslateTransform x:Name="RunnerOffset" X="-160" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="RunnerAnimation">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="RunnerOffset" Storyboard.TargetProperty="X" From="-160" To="1400" Duration="0:0:1.8" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="RunnerAnimation" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- Header search: placeholder, search glyph and an "Enter asks AI" hint -->
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="44,0,140,0" />
    <Setter Property="Background" Value="{StaticResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <Grid>
              <TextBlock Text="&#xE721;" Style="{StaticResource Text.Glyph}" FontSize="15" Foreground="{StaticResource TextTertiaryBrush}" Margin="16,0,0,0" HorizontalAlignment="Left" />
              <TextBlock x:Name="Placeholder"
                         Text="{TemplateBinding Tag}"
                         Foreground="{StaticResource TextTertiaryBrush}"
                         Margin="46,0,16,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
              <Border x:Name="Hint" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="8,3" CornerRadius="4" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                <TextBlock Text="Enter ↵ asks AI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Assistant input: search glyph on the left, room for the send button on the right -->
  <Style x:Key="AskBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="40,0,50,0" />
    <Setter Property="Height" Value="46" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{StaticResource InputBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <Grid>
              <TextBlock Text="&#xE721;" Style="{StaticResource Text.Glyph}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Margin="14,0,0,0" HorizontalAlignment="Left" />
              <TextBlock x:Name="Placeholder"
                         Text="{TemplateBinding Tag}"
                         Foreground="{StaticResource TextTertiaryBrush}"
                         Margin="42,0,50,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A525D" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Drive selector in the header: the drive's name set like a label on the drive, dropdown lists every drive -->
  <Style x:Key="DriveSelector" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <Grid Width="300" Margin="2,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xEDA2;" Style="{StaticResource Text.Glyph}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,6">
                <Run Text="{Binding Description, Mode=OneWay}" />
                <Run Text="   " />
                <Run Text="{Binding FreeBytes, Mode=OneWay, Converter={StaticResource BytesToText}}" />
                <Run Text="free" />
              </TextBlock>
              <ProgressBar Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" Height="3" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" Foreground="{StaticResource TextBrush}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="Transparent" CornerRadius="10" Padding="4,2,14,2">
                    <StackPanel Orientation="Horizontal">
                      <Image Source="{StaticResource DriveArtwork}" Width="54" Height="40" />
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType=ComboBox}, FallbackValue='No drives found'}"
                                     FontFamily="{StaticResource NumberFont}"
                                     FontSize="24"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="&#xE70D;" Style="{StaticResource Text.Glyph}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="10,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedItem.Description, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,1,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Margin="0,4,0,0"
                      Background="#1F242A"
                      BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="4">
                <ScrollViewer MaxHeight="400">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
