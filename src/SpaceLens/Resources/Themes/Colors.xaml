<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces (sampled from references/ui-reference.png) -->
  <Color x:Key="WindowColor">#0E1621</Color>
  <Color x:Key="SidebarColor">#0F1823</Color>
  <Color x:Key="SurfaceColor">#121C28</Color>
  <Color x:Key="SurfaceRaisedColor">#16212F</Color>
  <Color x:Key="SurfaceHoverColor">#192636</Color>
  <Color x:Key="InputColor">#0F1925</Color>
  <Color x:Key="BorderColor">#1E2A3A</Color>
  <Color x:Key="BorderStrongColor">#2A3A50</Color>

  <!-- Text -->
  <Color x:Key="TextColor">#E8EEF6</Color>
  <Color x:Key="TextSecondaryColor">#A4B4C8</Color>
  <Color x:Key="TextTertiaryColor">#6C7E94</Color>

  <!-- Accent and status -->
  <Color x:Key="AccentColor">#2F8CFF</Color>
  <Color x:Key="AccentHoverColor">#4C9DFF</Color>
  <Color x:Key="AccentPressedColor">#1E6FD9</Color>
  <Color x:Key="SelectionColor">#14345C</Color>
  <Color x:Key="SelectionBorderColor">#22508A</Color>
  <Color x:Key="SuccessColor">#3DD68C</Color>
  <Color x:Key="WarningColor">#F2B33D</Color>
  <Color x:Key="DangerColor">#F2777C</Color>
  <Color x:Key="PurpleColor">#A78BFA</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
  <SolidColorBrush x:Key="RingTrackBrush" Color="#1D3047" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#C80A1018" />

  <!-- Cleanup risk badges -->
  <SolidColorBrush x:Key="RiskLowBackground" Color="#0E3527" />
  <SolidColorBrush x:Key="RiskLowForeground" Color="#4FD69C" />
  <SolidColorBrush x:Key="RiskReviewBackground" Color="#3A2C0E" />
  <SolidColorBrush x:Key="RiskReviewForeground" Color="#F5BF4F" />
  <SolidColorBrush x:Key="RiskHighBackground" Color="#3D1B22" />
  <SolidColorBrush x:Key="RiskHighForeground" Color="#FF8F94" />
  <SolidColorBrush x:Key="RiskProtectedBackground" Color="#1B2738" />
  <SolidColorBrush x:Key="RiskProtectedForeground" Color="#93A7C3" />

  <!-- Summary card icon tiles -->
  <SolidColorBrush x:Key="TileGreenBackground" Color="#14382E" />
  <SolidColorBrush x:Key="TilePurpleBackground" Color="#272457" />
  <SolidColorBrush x:Key="TileBlueBackground" Color="#16304D" />

  <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
