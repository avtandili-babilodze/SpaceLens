<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces: neutral graphite, so colour is left for what it means (the accent, risk, file types) -->
  <Color x:Key="WindowColor">#14171B</Color>
  <Color x:Key="SidebarColor">#101317</Color>
  <Color x:Key="SurfaceColor">#1A1E23</Color>
  <Color x:Key="SurfaceRaisedColor">#20252B</Color>
  <Color x:Key="SurfaceHoverColor">#252A31</Color>
  <Color x:Key="InputColor">#111418</Color>
  <Color x:Key="BorderColor">#262B32</Color>
  <Color x:Key="BorderStrongColor">#38404A</Color>
  <Color x:Key="DividerColor">#1F2329</Color>

  <!-- Text -->
  <Color x:Key="TextColor">#ECEEF0</Color>
  <Color x:Key="TextSecondaryColor">#A0A8B2</Color>
  <Color x:Key="TextTertiaryColor">#7F8893</Color>

  <!-- Accent: only for what you can act on now (main action, selection, focus) and used space -->
  <Color x:Key="AccentColor">#3D8BFF</Color>
  <Color x:Key="AccentHoverColor">#5C9DFF</Color>
  <Color x:Key="AccentPressedColor">#2F74E0</Color>
  <Color x:Key="AccentTextColor">#7EB2FF</Color>
  <Color x:Key="SelectionColor">#1D2C40</Color>
  <Color x:Key="SelectionBorderColor">#2F5182</Color>

  <!-- Status -->
  <Color x:Key="SuccessColor">#4CC38A</Color>
  <Color x:Key="WarningColor">#E8B04A</Color>
  <Color x:Key="DangerColor">#F07C7C</Color>
  <Color x:Key="PurpleColor">#A78BFA</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
  <SolidColorBrush x:Key="CapacityTrackBrush" Color="#22272D" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#C80B0D10" />

  <!-- Cleanup risk: a dot or a quiet tag; the colours keep their meaning on every page -->
  <SolidColorBrush x:Key="RiskLowBackground" Color="#14291F" />
  <SolidColorBrush x:Key="RiskLowForeground" Color="#5BCF97" />
  <SolidColorBrush x:Key="RiskReviewBackground" Color="#2E2513" />
  <SolidColorBrush x:Key="RiskReviewForeground" Color="#E9B44C" />
  <SolidColorBrush x:Key="RiskHighBackground" Color="#33191C" />
  <SolidColorBrush x:Key="RiskHighForeground" Color="#F28B8B" />
  <SolidColorBrush x:Key="RiskProtectedBackground" Color="#22272E" />
  <SolidColorBrush x:Key="RiskProtectedForeground" Color="#9AA4B0" />

  <!-- Summary tiles on the Cleanup and History pages -->
  <SolidColorBrush x:Key="TileGreenBackground" Color="#14291F" />

  <!-- Type: Bahnschrift (Windows' DIN face) for measurements and titles, Segoe UI for everything you read -->
  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="NumberCondensedFont">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
