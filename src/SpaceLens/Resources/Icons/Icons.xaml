<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Windows 11 style folder (20 x 16) -->
  <Geometry x:Key="FolderBackGeometry">M1.5,2.5 C1.5,1.67 2.17,1 3,1 L7.4,1 C7.8,1 8.18,1.16 8.46,1.44 L10,3 L17,3 C17.83,3 18.5,3.67 18.5,4.5 L18.5,13.5 C18.5,14.33 17.83,15 17,15 L3,15 C2.17,15 1.5,14.33 1.5,13.5 Z</Geometry>
  <Geometry x:Key="FolderFrontGeometry">M1.5,6 C1.5,5.45 1.95,5 2.5,5 L17.5,5 C18.05,5 18.5,5.45 18.5,6 L18.5,13.5 C18.5,14.33 17.83,15 17,15 L3,15 C2.17,15 1.5,14.33 1.5,13.5 Z</Geometry>
  <LinearGradientBrush x:Key="FolderFrontBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFD866" Offset="0" />
    <GradientStop Color="#F4B63C" Offset="1" />
  </LinearGradientBrush>

  <DataTemplate x:Key="FolderShape">
    <Viewbox Stretch="Uniform">
      <Canvas Width="20" Height="16">
        <Path Data="{StaticResource FolderBackGeometry}" Fill="#DDA03A" />
        <Path Data="{StaticResource FolderFrontGeometry}" Fill="{StaticResource FolderFrontBrush}" />
      </Canvas>
    </Viewbox>
  </DataTemplate>

  <!-- Icon for any scanned item; the content is a NodeIcon value -->
  <DataTemplate x:Key="NodeIconTemplate">
    <Grid Width="20" Height="20">
      <ContentControl ContentTemplate="{StaticResource FolderShape}"
                      Focusable="False"
                      Margin="0,1"
                      Visibility="{Binding Converter={StaticResource NodeIcon}, ConverterParameter=FolderVisibility}" />
      <TextBlock Text="{Binding Converter={StaticResource NodeIcon}, ConverterParameter=Glyph}"
                 Foreground="{Binding Converter={StaticResource NodeIcon}, ConverterParameter=Brush}"
                 FontFamily="{StaticResource IconFont}"
                 FontSize="16"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="{Binding Converter={StaticResource NodeIcon}, ConverterParameter=GlyphVisibility}" />
    </Grid>
  </DataTemplate>

  <!-- Drive artwork for the header (64 x 48) -->
  <DrawingImage x:Key="DriveArtwork">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="M12,4 H52 Q56,4 57.5,8 L62,24 H2 L6.5,8 Q8,4 12,4 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#EEF0F2" Offset="0" />
              <GradientStop Color="#BCC2C9" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Brush="#A6ADB6" Geometry="M2,24 H62 V37 Q62,44 55,44 H9 Q2,44 2,37 Z" />
        <GeometryDrawing Brush="#23282E" Geometry="M5,27 H59 V36 Q59,41 54,41 H10 Q5,41 5,36 Z" />
        <GeometryDrawing Brush="#4CC38A" Geometry="M10,32 H14 V35 H10 Z" />
        <GeometryDrawing Brush="#4CC38A" Geometry="M16,32 H20 V35 H16 Z" />
        <GeometryDrawing Brush="#3D8BFF" Geometry="M46,32 H54 V35 H46 Z" />
        <GeometryDrawing Brush="#3D8BFF" Geometry="M24,44 H40 V46 Q40,47 39,47 H25 Q24,47 24,46 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- App logo -->
  <DataTemplate x:Key="LogoMark">
    <Border Width="38" Height="38" CornerRadius="11">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#38B2FF" Offset="0" />
          <GradientStop Color="#1660E0" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="3.2" />
        <Ellipse Width="6" Height="6" Fill="White" Margin="11,0,0,11" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Summary card artwork (24 x 24 strokes) -->
  <Geometry x:Key="LeafGeometry">M20,3.5 C11,3.5 4.5,8.5 4.5,15.5 C4.5,17.6 5.2,19.4 6.4,20.6 C13.5,20.6 20,15 20,3.5 Z M6.4,20.6 C9,15.5 12.5,12 16,10</Geometry>
  <Geometry x:Key="TrendGeometry">M3,17 L9,11 L13,15 L21,7 M15,7 L21,7 L21,13</Geometry>
  <!-- AI assistant mark: a large and a small sparkle, drawn filled -->
  <Geometry x:Key="SparkleGeometry">M10,4 Q11,11 18,12 Q11,13 10,20 Q9,13 2,12 Q9,11 10,4 Z M19,1.5 Q19.4,4.6 22.5,5 Q19.4,5.4 19,8.5 Q18.6,5.4 15.5,5 Q18.6,4.6 19,1.5 Z</Geometry>
  <Geometry x:Key="FileGeometry">M7,3 L14,3 L19,8 L19,20 C19,20.55 18.55,21 18,21 L7,21 C6.45,21 6,20.55 6,20 L6,4 C6,3.45 6.45,3 7,3 Z M14,3 L14,8 L19,8</Geometry>

</ResourceDictionary>
