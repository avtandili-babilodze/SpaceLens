<UserControl x:Class="SpaceLens.Views.CompareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Storage Time Machine" Style="{StaticResource Heading}" />
        <TextBlock Text="See what changed, using snapshots saved on this device." Foreground="{StaticResource Muted}" Margin="0,0,0,22" />
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="EARLIER SNAPSHOT" Style="{StaticResource Caption}" Margin="0,0,0,7" />
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Before}" DisplayMemberPath="DisplayName" FontSize="11" AutomationProperties.AutomationId="BeforeSnapshot" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="2">
          <TextBlock Text="LATER SNAPSHOT" Style="{StaticResource Caption}" Margin="0,0,0,7" />
          <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding After}" DisplayMemberPath="DisplayName" FontSize="11" AutomationProperties.AutomationId="AfterSnapshot" />
        </StackPanel>
        <Button Grid.Column="3" Command="{Binding CompareCommand}" Content="Compare scans" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" AutomationProperties.AutomationId="CompareScans" />
      </Grid>
      <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,18,0,16" />
      <DataGrid Grid.Row="3" ItemsSource="{Binding Changes}" AutomationProperties.AutomationId="ScanChanges">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Location" Binding="{Binding FullPath}" Width="*" />
          <DataGridTextColumn Header="Before" Binding="{Binding BeforeText}" Width="90" />
          <DataGridTextColumn Header="After" Binding="{Binding AfterText}" Width="90" />
          <DataGridTextColumn Header="Change" Binding="{Binding DeltaText}" Width="100" />
          <DataGridTextColumn Header="Observation" Binding="{Binding Kind}" Width="125" />
          <DataGridTemplateColumn Header="" Width="75">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Locate" FontSize="10" Padding="7,4" Command="{Binding DataContext.LocateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,15,0,0">
        <Button Command="{Binding DataContext.OpenSnapshotCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding After}" Content="Open later snapshot" FontSize="11" />
        <TextBlock Text="Completed scans are saved automatically. No application attribution is inferred." Style="{StaticResource Caption}" Margin="14,0,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>