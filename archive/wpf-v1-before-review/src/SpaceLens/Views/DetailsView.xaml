<UserControl x:Class="SpaceLens.Views.DetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ContentControl Content="{Binding Details.Entry}" ContentTemplate="{StaticResource EntryIconTemplate}" HorizontalAlignment="Left" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Details.Entry.Name,FallbackValue=Folder details}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Details.Entry.FullPath,FallbackValue=Select a scanned folder}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Details.Entry.SizeText,FallbackValue=—}" FontSize="30" FontWeight="SemiBold" Margin="0,20,0,4" />
        <TextBlock Text="Measured logical file size" FontSize="10" Foreground="{StaticResource Muted}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
          <TextBlock Text="{Binding Details.Entry.FileCount,StringFormat={}{0:N0} files}" Style="{StaticResource Caption}" />
          <TextBlock Text=" · " Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding Details.Entry.FolderCount,StringFormat={}{0:N0} folders}" Style="{StaticResource Caption}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Details.Categories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Background="{Binding Color}" Width="7" Height="7" CornerRadius="2" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Muted}" />
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" />
                </Grid>
                <ProgressBar Value="{Binding Percent}" Height="3" Foreground="{Binding Color}" Background="#222F40" BorderThickness="0" Margin="0,6,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,13" />
        <Grid Margin="0,0,0,8">
          <TextBlock Text="Largest files" FontWeight="SemiBold" FontSize="12" />
          <TextBlock Text="IN THIS LOCATION" FontSize="8" Foreground="#5E7693" HorizontalAlignment="Right" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Details.LargestFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.NavigateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="0,8" HorizontalContentAlignment="Stretch" ToolTip="{Binding FullPath}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding IconColor}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10" Foreground="{StaticResource Muted}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="#30272B" CornerRadius="5" Padding="9" Margin="0,10,0,0" Visibility="{Binding Details.Entry.Warning,Converter={StaticResource HasValueVisibility}}">
          <TextBlock Text="{Binding Details.Entry.Warning}" TextWrapping="Wrap" FontSize="10" Foreground="#DDBB9C" />
        </Border>
        <Button Command="{Binding RevealCommand}" CommandParameter="{Binding Details.Entry}" Margin="0,16,0,0" FontSize="11" Content="Reveal in Windows Explorer" />
        <TextBlock Text="Logical sizes may differ from physical disk usage. Hard links are counted per path; junctions are skipped." Foreground="#627791" TextWrapping="Wrap" FontSize="9" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>