<UserControl x:Class="SpaceLens.Views.AssistantView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="14">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="25" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}" />
        <TextBlock Grid.Column="1" Text="Storage assistant" FontWeight="SemiBold" FontSize="12" />
        <Button Grid.Column="2" Command="{Binding ToggleExpandedCommand}" Content="↕" Style="{StaticResource QuietButton}" Padding="4,0" ToolTip="Expand or collapse assistant" AutomationProperties.Name="Toggle assistant" />
      </Grid>
      <StackPanel Visibility="{Binding IsExpanded,Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding ContextLabel,StringFormat=Context: {0}}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,9" TextTrimming="CharacterEllipsis" />
        <ScrollViewer x:Name="ChatScroll" Height="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#101923" CornerRadius="6" Padding="10" Margin="0,0,0,7">
                  <StackPanel>
                    <TextBlock Text="{Binding Speaker}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,5" />
                    <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
                    <ItemsControl ItemsSource="{Binding References}" Margin="0,5,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Label}" Command="{Binding DataContext.LocateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Foreground="{StaticResource Accent}" FontSize="10" Padding="0,3" ToolTip="{Binding FullPath}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="Thinking…" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding Input,UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="9" ToolTip="Ask about your scanned storage" AutomationProperties.AutomationId="AssistantInput">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="1" Command="{Binding SendCommand}" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Padding="11,8" ToolTip="Send question" AutomationProperties.AutomationId="SendQuestion" />
        </Grid>
        <Grid Margin="0,7,0,0">
          <Button Command="{Binding ClearCommand}" Content="Clear chat" Style="{StaticResource QuietButton}" Padding="0,3" FontSize="9" HorizontalAlignment="Left" />
          <Button Command="{Binding SendCancelCommand}" Content="Cancel request" Style="{StaticResource QuietButton}" Padding="0,3" FontSize="9" HorizontalAlignment="Right" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>