<UserControl x:Class="SpaceLens.Views.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Storage Goal Solver" Style="{StaticResource Heading}" />
        <TextBlock Text="Make room with a plan you can review." Foreground="{StaticResource Muted}" Margin="0,0,0,20" />
      </StackPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding Goal,UpdateSourceTrigger=PropertyChanged}" ToolTip="For example: I need to free 25 GB" AutomationProperties.AutomationId="CleanupGoal" />
        <Button Grid.Column="1" Command="{Binding SolveCommand}" Content="Create review plan" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" AutomationProperties.AutomationId="CreatePlan" />
        <StackPanel Grid.Column="2" Margin="24,0,0,0">
          <TextBlock Text="POTENTIAL SAVINGS" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding Plan.PotentialText,FallbackValue=—}" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#1B2634" CornerRadius="6" Padding="14" Margin="0,18,0,15">
        <StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="18" FontSize="12" />
          <TextBlock Text="Review preview only · no deletion commands · no automatically safe files" FontSize="10" Foreground="#BFAE85" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <DataGrid Grid.Row="3" ItemsSource="{Binding Candidates}" AutomationProperties.AutomationId="CleanupCandidates">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="File" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                  <TextBlock Text="{Binding FullPath}" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
          <DataGridTemplateColumn Header="Risk" Width="125">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RiskBadge}">
                  <TextBlock Text="{Binding RiskText}" FontSize="10" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Consequences / review conditions" Binding="{Binding Reason}" Width="3*" />
          <DataGridTemplateColumn Header="" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Inspect" FontSize="10" Padding="9,4" Command="{Binding DataContext.InspectCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</UserControl>