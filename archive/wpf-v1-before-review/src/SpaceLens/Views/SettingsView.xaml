<UserControl x:Class="SpaceLens.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="26">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource Heading}" />
        <TextBlock Text="AI assistant" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
        <TextBlock Text="Claude Haiku 5.5 · official Anthropic Messages API" Foreground="{StaticResource Muted}" Margin="0,0,0,22" />
        <TextBlock Text="Anthropic API key" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox x:Name="ApiKey" MinWidth="400" MaxLength="512" AutomationProperties.AutomationId="AnthropicApiKey" ToolTip="Paste your Anthropic API key. It will be encrypted with Windows DPAPI." />
          <Button Grid.Column="1" Content="Save key" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="SaveKey_Click" AutomationProperties.AutomationId="SaveApiKey" />
        </Grid>
        <TextBlock Text="Encrypted locally with Windows DPAPI, for the current Windows user. The key is never shown again." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,9,0,18" />
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding TestConnectionCommand}" Content="Test connection" AutomationProperties.AutomationId="TestConnection" />
          <Button Command="{Binding RemoveKeyCommand}" Content="Remove saved key" Margin="9,0,0,0" />
          <Button Command="{Binding TestConnectionCancelCommand}" Content="Cancel" Margin="9,0,0,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
        <Border Background="#1B2939" CornerRadius="6" Padding="13" Margin="0,15,0,8">
          <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.AutomationId="ConnectionStatus" />
        </Border>
        <TextBlock Text="Connection testing sends only a synthetic prompt. It makes a real, small, billable API request." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,3,0,15" />
        <TextBlock Text="Privacy and analysis mode" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
        <CheckBox IsChecked="{Binding UseClaude}" Content="Use Claude Haiku for storage questions" AutomationProperties.AutomationId="UseClaude" />
        <CheckBox IsChecked="{Binding ShareMetadata}" AutomationProperties.AutomationId="ShareMetadata">
          <TextBlock Text="I consent to sending my question, recent chat, and a limited selection of file paths, sizes, types, modification dates, and scan differences to Anthropic." TextWrapping="Wrap" MaxWidth="700" Foreground="{StaticResource Muted}" />
        </CheckBox>
        <TextBlock Text="No file contents or complete inventory are uploaded. Sharing is off on every launch. Offline analysis, scanning, and cleanup planning work without a key." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,24" />
        <TextBlock Text="Local data" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
        <TextBlock Text="Snapshots are stored in SQLite. Cancelled and interrupted scans are labeled as incomplete and are excluded from comparison and cleanup planning." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>